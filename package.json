{
  "name": "grok-bot-line-relay",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "cloudflare": {
    "bindings": {
      "RELAY_KEY": {
        "description": "この Worker 専用の合言葉です。推測されにくい長いランダムな文字列を入れてください（例: `openssl rand -hex 32` の出力）。LINE に登録する URL の `key=` にも同じものを入れます。チャットには貼らないでください。"
      }
    }
  }
}
